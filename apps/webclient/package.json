{
  "name": "@aya/webclient",
  "description": "A minimal, type-safe full-stack React starter template with modern tooling",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && deno check \"src/**/*.test.ts\"",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "start": "deno run -A .output/server/index.mjs",
    "test": "deno test --no-check --allow-read --allow-env --allow-write=. src/",
    "test:update": "deno test --no-check --allow-read --allow-env --allow-write=. -- --update src/",
    "test:ci": "deno test --no-check --allow-read --allow-env src/"
  },
  "dependencies": {
