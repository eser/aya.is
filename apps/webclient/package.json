    "i18next-resources-to-backend": "^1.2.3",
    "input-otp": "^1.5.0",
    "jose": "^6.2.9",
    "lucide-react": "^0.575.0",
    "negotiator": "^1.0.0",
    "next-themes": "^0.4.6",
