// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`boolean prop 1`] = `"<Group border={true} rounded={false} padding="md">"`;

exports[`container 1`] = `"<Callout variant="info">"`;

exports[`empty props 1`] = `"<Verse>"`;

exports[`escape special chars 1`] = `"<Callout title="say &quot;hello&quot;">"`;

exports[`self-closing 1`] = `"<Spacer size="md" />"`;

exports[`string props 1`] = `"<Callout variant="info" title="Note">"`;
