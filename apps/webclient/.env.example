# Application
PORT=3000

# Client-side variables (bundled by Vite, exposed to browser)
# Use VITE_ prefix for any variable that needs to be accessible in the browser
VITE_HOST=http://localhost:3000
VITE_BACKEND_URI=http://localhost:8080

# Server-side variables (only available in SSR and server functions)
# These are NOT exposed to the browser
BACKEND_URI=http://localhost:8080

# Commands (run from apps/webclient; install from the repository root with `pnpm install`):
#   pnpm dev                      # Start development server
#   pnpm build                    # Build for production
#   pnpm start                    # Start production server
