{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @aya/webclient dev",
    "build": "pnpm --filter @aya/webclient build",
    "start": "pnpm --filter @aya/webclient start",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "pnpm --filter @aya/webclient lint && pnpm lint:scripts",
    "lint:scripts": "oxlint scripts",
    "typecheck": "pnpm --filter @aya/webclient typecheck",
    "test": "pnpm --filter @aya/webclient test"
  },
  "devDependencies": {
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
